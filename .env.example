# Copia este archivo como .env.local y completa los valores.

# Supabase → Project Settings → API (o "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
# Clave pública: "Publishable key" (sb_publishable_…) o la "anon key" en proyectos antiguos
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Página web: para avisarle cuando cambian el menú o las promociones
WEBSITE_URL=http://localhost:3000
WEBSITE_REVALIDATE_URL=http://localhost:3000/api/revalidate
# Debe ser EXACTAMENTE el mismo valor en la página web. Genera uno largo y aleatorio.
REVALIDATE_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio
